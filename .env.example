# =====================================================================
# Godrej Cricket Intelligence — Environment Configuration Template
# =====================================================================
# Copy this file to .env and populate the actual secrets.
# NEVER commit .env to source control or expose API keys in reports/logs.

# --- Cricket Data / CricAPI Configuration ---
CRICAPI_KEY=your_cricketdata_api_key_here
CRICAPI_BASE_URL=https://api.cricapi.com/v1

# --- Daily API Quota & Throttling Limits ---
# CricAPI Lifetime Free Tier has a hard ceiling of 100 hits/day.
API_DAILY_QUOTA_LIMIT=100
API_SAFETY_MARGIN_HITS=10
# Interval (seconds) between external API requests in Live Mode (min 120s recommended to conserve quota)
API_POLL_INTERVAL_SECONDS=120

# --- Engine Execution Mode ---
# Modes: "live" (calls external CricAPI) | "fixture_replay" (deterministic simulation using offline JSON)
INGESTION_MODE=fixture_replay
# Security opt-in required to invoke live CricAPI endpoints (defaults to false)
ALLOW_LIVE_API=false
# Speed (seconds) at which simulated overs/events advance in fixture_replay mode
SIMULATION_SPEED_SECONDS=30

# --- Target Match Filter (Optional) ---
# If empty, the ingestion service auto-selects the first active match from /currentMatches
TARGET_MATCH_ID=

# --- Local PostgreSQL Database Configuration ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=godrej_cricket_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# --- Logging & Observability ---
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Path for local structured log file
LOG_FILE_PATH=logs/ingestion.log
