{
  "name": "Team Elite Crew - Cricket Intelligence Theme",
  "dataColors": [
    "#00E676",
    "#00E5FF",
    "#FFD600",
    "#FF3D00",
    "#2979FF",
    "#B388FF",
    "#00C853",
    "#FF6D00"
  ],
  "background": "#06120E",
  "foreground": "#FFFFFF",
  "tableAccent": "#00E676",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": { "solid": { "color": "#06120E" } },
            "foregroundColor": { "solid": { "color": "#FFFFFF" } }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#06120E" } },
            "transparency": 100
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 24,
            "color": { "solid": { "color": "#FFFFFF" } }
          }
        ],
        "categoryLabels": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "color": { "solid": { "color": "#80B89C" } }
          }
        ],
        "background": [
          {
            "show": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#0A3A28" } }
          }
        ],
        "columnHeaders": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "fontColor": { "solid": { "color": "#00E676" } },
            "backColor": { "solid": { "color": "#081F15" } }
          }
        ],
        "values": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9.5,
            "fontColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "backColorPrimary": { "solid": { "color": "#0A2218" } },
            "fontColorSecondary": { "solid": { "color": "#FFFFFF" } },
            "backColorSecondary": { "solid": { "color": "#061811" } }
          }
        ],
        "background": [
          {
            "show": false
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "legend": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "color": { "solid": { "color": "#80B89C" } }
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "labelColor": { "solid": { "color": "#80B89C" } }
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "labelColor": { "solid": { "color": "#80B89C" } },
            "gridlineColor": { "solid": { "color": "#0A3A28" } }
          }
        ]
      }
    }
  }
}
